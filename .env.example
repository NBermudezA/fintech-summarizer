# Copy to .env.local for local development. Set the same keys in Vercel →
# Project → Settings → Environment Variables for Preview and Production.

# Required
ANTHROPIC_API_KEY=
NEWS_API_KEY=

# Optional
# OPENAI_API_KEY=                      # only if you re-enable the GPT provider
# ANTHROPIC_MODEL=claude-haiku-5-5     # override the default model per environment
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX       # GA4 measurement ID; analytics stay off when unset
# NEXT_PUBLIC_SITE_URL=https://your-domain.com  # canonical URL once a custom domain is attached
